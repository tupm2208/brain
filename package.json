{
  "name": "toprun-bo-nao",
  "private": true,
  "version": "0.1.0",
  "description": "The brain (chatbot engine) and licence server running on Xeon. Three packages: contract, brain, xeon.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "check": "tsc --build --dry && tsc -p tsconfig.test.json",
    "clean": "tsc --build --clean",
    "start": "node packages/xeon/dist/main.js",
    "tien-trinh:xem": "node scripts/cpanel/tien-trinh.mjs xem",
    "tien-trinh:tat": "node scripts/cpanel/tien-trinh.mjs tat",
    "test": "npm run build && node --test --test-timeout=60000 --test-force-exit \"packages/*/test/*.test.mts\"",
    "test:mysql": "npm run build && node --test --test-concurrency=1 --test-timeout=60000 --test-force-exit packages/xeon/test-mysql/integration.test.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
