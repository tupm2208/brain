        "gia",
        "bao nhieu",
        "nhieu tien"
      ],
      "requiredSlots": [
        "item"
      ],
      "tools": [
        "stock.lookup"
      ],
      "template": "{tinhtrang}",
      "askBackTemplate": "{khach} cho {shop} xin mã hoặc tên mẫu, {shop} báo giá đúng mẫu đó ạ.",
      "examples": [
        "doi nay gia bao nhieu"
      ]
    },
    {
      "id": "tra_don",
      "name": "Tra don hang",
      "keywords": [
        "don hang",
        "van don",
        "toi dau",
        "khi nao nhan",
        "ship den dau",
        "don cua em"
      ],
      "requiredSlots": [
        "phone"
      ],
