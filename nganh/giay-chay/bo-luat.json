      "patterns": [
        "\\bdoi\\s+(size|hang|tra)\\b"
      ],
      "requiredSlots": [
        "topic"
      ],
      "tools": [
        "policy.get"
      ],
      "template": "{chinhsach}",
      "askBackTemplate": "{khach} cho {shop} biết {khach} muốn đổi hay trả, và mua cách đây bao lâu ạ.",
      "examples": [
        "shop cho doi size khong a",
        "hang bao hanh the nao"
      ]
    }
