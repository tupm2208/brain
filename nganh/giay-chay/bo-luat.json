    },
    {
      "kind": "no_unsourced_numbers"
    },
    {
      "kind": "brand_not_carried_needs_catalog",
      "minItems": 200
    },
    {
      "kind": "require_source_for_claims",
      "topics": [
        "đổi trả",
        "bảo hành",
        "phí ship",
        "hoàn tiền"
      ],
      "patterns": [
        "đổi\\s+(size|hàng|trả)",
