# XEON (bo-nao) — chép tệp này thành `.env` cùng thư mục rồi điền.
#   cp .env.example .env
# `.env` KHÔNG vào git. Biến đặt sẵn trong môi trường đè lên tệp.
# Dòng bắt đầu bằng # là chưa đặt: bỏ dấu # khi cần. Không viết chú thích sau giá trị trên cùng dòng.

# Cổng nghe.
PORT=4200

# Địa chỉ công khai của Xeon, trả cho landing lúc đăng ký.
XEON_DIA_CHI=https://xeon.toprun.vn

# Mật khẩu trang /quan-tri, từ 12 ký tự. Để trống = trang quản trị TẮT.
XEON_ADMIN_MAT_KHAU=

# Bí mật ký cookie phiên admin. Để trống = sinh mới mỗi lần khởi động (khởi động lại là đăng xuất).
XEON_BI_MAT_PHIEN=

# Khoá AI cho bộ viết bài — giữ MỘT lần trên Xeon cho mọi shop. Để trống = cửa viết bài trả 503.
ANTHROPIC_API_KEY=
# XEON_MO_HINH_VIET=claude-opus-5

# Agent AI trả lời khách (16/09/2026 — agent cấp 2 của Sales Desk chuyển sang Xeon). Cổng tương thích
# OpenAI (/chat/completions). Để trống URL hoặc KEY = bot chỉ trả lời bằng máy luật.
XEON_AI_CHAT_URL=
XEON_AI_CHAT_KEY=
# XEON_AI_CHAT_MODEL=ag/gemini-3.7-flash-low
# XEON_AI_LUOT_GIO=120
# Gom tin như Sales Desk: chờ sau tin khách để gom cả chùm (0 = tắt), chờ thêm khi có / nhắc tới ảnh.
# XEON_GOM_TIN_MS=6000
# XEON_CHO_ANH_MS=7000

# App Meta của NHÀ PHÁT TRIỂN — một app cho mọi shop (15/09/2026). Webhook của app trỏ về
# <XEON_DIA_CHI>/meta/webhook. App Secret chỉ nằm ở đây, không để trên hosting của shop.
# Để trống = /meta/webhook từ chối.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=
# META_GRAPH_API_VERSION=v23.0

# Nơi giữ sổ license + khoá ký (SAO LƯU thư mục này). Mặc định: bo-nao/du-lieu.
# XEON_THU_MUC_DU_LIEU=/srv/xeon/du-lieu

# Có nginx / Cloudflare đứng trước và chạy HTTPS.
# XEON_HTTPS=1
# TIN_PROXY=1

# Đ9 Video Studio — dịch vụ RIÊNG: `npm run start:video` (chỉ đọc khoá công khai trong thư mục dữ liệu).
# Địa chỉ công khai của dịch vụ đó (Xeon ghi vào vé). Trống = nút Video Studio báo "chưa bật".
# XEON_VIDEO_DIA_CHI=https://video.xeon.toprun.vn
# XEON_VIDEO_CONG=4190
# Công cụ dựng video (toprun-video-studio). Trống = trang khung báo chưa cài.
# XEON_VIDEO_CONG_CU=http://127.0.0.1:4180
# Mã riêng cho các Image Worker headless. Để trống thì cửa worker tắt.
XEON_IMAGE_WORKER_KEY=

# Cong cu anh (21/09/2026): Xeon go cua tool qua tunnel Cloudflare khi co ma can boc.
# THIEU MOT TRONG HAI LA TAT HAN, khong day viec — nua cau hinh khong duoc trong nhu dang chay.
XEON_IMAGE_TOOL_DIA_CHI=https://imagetool.elevenvoice.site
XEON_IMAGE_TOOL_MA=

# HỒ SƠ LƯỢT (21/09/2026) — giữ đủ một lượt trả lời để TRA nguyên nhân và DIỄN LẠI được bug.
# TRỐNG = TẮT, không ghi gì. Hồ sơ giữ MỘT PHẦN dữ liệu khách (lời khách, SĐT, địa chỉ) có thời hạn,
# nên phải bật có chủ ý. Đọc KE-HOACH-NHAT-KY-CHAN-DOAN.md trước khi bật.
# Hồ sơ là TỆP trên máy Xeon, đọc bằng công cụ chan-doan — KHÔNG BAO GIỜ đưa ra /nhat-ky (đường đó mở công khai).
# XEON_HO_SO_THU_MUC=logs/ho-so
# Số ngày giữ: lượt thường / lượt hỏng (mặc định 7 và 30).
# XEON_HO_SO_NGAY_THUONG=7
# XEON_HO_SO_NGAY_HONG=30

# NHẬT KÝ CÁC LANDING ĐẨY LÊN (21/09/2026) — POST /nhat-ky/gom.
# Chỉ là hạ tầng: đường, mã trạng thái, thời gian, mã vết. Lời khách KHÔNG đi đường này.
# Trống = cửa đó trả 503 và nói rõ là chưa bật.
# XEON_NHAT_KY_THU_MUC=logs/nhat-ky-landing
# Số ngày giữ (mặc định 14).
# XEON_NHAT_KY_NGAY=14

# CHẾ ĐỘ CŨ, chỉ để chạy thử — bản thật phục vụ shop theo sổ license.
# MA_NHAN_TIN=
# SHOP_JSON='{"toprun":{"diaChi":"http://127.0.0.1:4181","ma":"...","nganh":"giay-chay"}}'
# Tùy chọn: nhận JSON tổng kết khi Image Worker xử lý hết một lô.
IMAGE_WORKER_NOTIFY_WEBHOOK=

# ── Kết nối Fanpage: chỉ scripts/ket-noi-page.ps1 đọc (đăng ký landing + nối page vào Xeon) ──
# KET_NOI_XEON=https://brain.toprun.site
# KET_NOI_LICENSE_KEY=
# KET_NOI_LANDING_URL=
# KET_NOI_PAGE_ID=
# KET_NOI_PAGE_NAME=
# KET_NOI_PAGE_TOKEN=
